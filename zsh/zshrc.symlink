# shortcut to this dotfiles path is $ZSHDOT
export ZSHDOT=$HOME/.dotfiles

# your project folder that we can `c [tab]` to
export PROJECTS=~/Code

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSHDOT/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# AWS vault
if [[ $(command -v aws-vault) ]]; then
  eval "$(aws-vault --completion-script-zsh)"
  [[ -n "$AWS_VAULT" ]] && PS1="%{$fg[yellow]%}[aws::$AWS_VAULT]%{$reset_color%} $PS1"
fi




# Better history
# Credits to https://coderwall.com/p/jpj_6q/zsh-better-history-searching-with-arrow-keys
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search # Up
bindkey "^[[B" down-line-or-beginning-search # Down

# Find local branches that have been squash-merged into origin/main.
# Pass --test (or -n) for a dry-run that only lists candidates.
# Without flags, deletes them with `git branch -D`.
#
# Uses tree-equality via `git commit-tree` + `git cherry` because squash-merge
# rewrites SHAs, which makes `git branch --merged` useless.
git-prune-squashed() {
  local dry_run=0
  if [[ "$1" == "--test" || "$1" == "-n" ]]; then
    dry_run=1
  fi

  local target="origin/main"

  git fetch origin main --quiet || { print -u2 "fetch failed"; return 1 }

  local current
  current=$(git symbolic-ref --short HEAD 2>/dev/null)

  local -a merged
  local branch mergeBase tree commit

  while IFS= read -r branch; do
    [[ "$branch" == "main" || "$branch" == "master" || "$branch" == "$current" ]] && continue

    mergeBase=$(git merge-base "$target" "$branch" 2>/dev/null) || continue
    tree=$(git rev-parse "$branch^{tree}")
    commit=$(git commit-tree "$tree" -p "$mergeBase" -m _)

    if git cherry "$target" "$commit" 2>/dev/null | grep -q '^-'; then
      merged+=("$branch")
    fi
  done < <(git for-each-ref refs/heads/ --format='%(refname:short)')

  if (( ${#merged[@]} == 0 )); then
    print "No squash-merged branches found."
    return 0
  fi

  if (( dry_run )); then
    print "Would delete ${#merged[@]} squash-merged branch(es):"
    for branch in "${merged[@]}"; do
      print "  $branch"
    done
    return 0
  fi

  print "Deleting ${#merged[@]} squash-merged branch(es):"
  for branch in "${merged[@]}"; do
    git branch -D "$branch"
  done
}
